# Google OAuth - https://console.cloud.google.com/apis/credentials
# Crie um ID do Cliente OAuth 2.0 (Aplicativo da Web) e adicione http://localhost:5173 como origem JavaScript autorizada
VITE_GOOGLE_CLIENT_ID=SEU_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_ID=SEU_CLIENT_ID.apps.googleusercontent.com
# Admin - e-mails com permissão para editar cardápio (separados por vírgula, lowercase)
ADMIN_EMAILS=felipemq123@outlook.com
# Opcional: porta da API
PORT=3000
