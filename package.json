{
  "name": "projeto-cardapio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Site de cardapio para restaurante com checkout via WhatsApp",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch api/src/server.ts",
    "dev:all": "concurrently \"npm run dev:api\" \"npm run dev\"",
    "api": "tsx api/src/server.ts",
    "api:build": "tsc --project api/tsconfig.json",
    "api:start": "node api/dist/server.js",
    "build": "tsc --noEmit && vite build && tsc --project api/tsconfig.json",
    "start": "node api/dist/server.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:api": "tsc --noEmit --project api/tsconfig.json"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "fuse.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^6.3.0"
  }
}
